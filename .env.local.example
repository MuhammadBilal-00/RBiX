# Copy this file to .env.local (gitignored — never commit real values) and
# fill in the real values below before running `next dev` / building for a
# deploy that needs a working contact form.

# reCAPTCHA v3 site key (public — safe to expose client-side).
# Get this from https://www.google.com/recaptcha/admin — register a new
# site as reCAPTCHA v3 (NOT v2 "I'm not a robot"), for the real production
# domain(s) the site will be served from (add both rbixtechnologies.com and
# the Vercel staging domain if you want reCAPTCHA to work there too). The
# matching secret key goes server-side only — in php/config.php as
# RECAPTCHA_SECRET_KEY (cPanel) or as the RECAPTCHA_SECRET_KEY env var on
# Vercel staging — never here.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Where ContactForm.tsx POSTs the form JSON.
# Leave unset/blank for the production cPanel deploy — the component
# defaults to "/php/contact-handler.php", which is correct once the php/
# folder is uploaded alongside the exported out/ build into public_html.
# Set this to "/api/contact" only on the temporary Vercel staging
# deployment, which has no PHP runtime and instead runs the api/contact.js
# serverless shim (staging-only, no real mail delivery — see that file).
NEXT_PUBLIC_CONTACT_ENDPOINT=
